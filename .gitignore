# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Secret-bearing variable files (non-secret terraform.tfvars is committed)
*.secret.tfvars
secrets.auto.tfvars

# Local shell env (e.g. direnv's .envrc holding HCLOUD_TOKEN — Read Only
# only, per AGENTS.md; never the Read & Write token)
.envrc
.env

# OS/editor cruft
.DS_Store
*.swp

# Ansible: Galaxy-installed role content, pinned by exact version in that
# file, not committed itself. Fetched via:
#   ansible-galaxy role install -r ansible/requirements.yml -p ansible/roles
ansible/roles/geerlingguy.docker/

# Python bytecode from the CI-configuration test suite (.github/tests/).
__pycache__/

# npm's install tree for .github/package.json, which pins the OpenSpec CLI that
# pr-validation.yml validates the specification record with. The manifest and
# its lockfile ARE committed -- they are the pin; what is installed from them
# is not. `npm ci` recreates this from the lockfile exactly.
node_modules/
