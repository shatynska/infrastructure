---
# ansible/roles/geerlingguy.docker/ is third-party content fetched by
# `ansible-galaxy install -r ansible/requirements.yml` (pinned by exact
# version there, gitignored, never committed — see .gitignore). It's not
# this project's code to lint or fix; excluding it is what keeps
# pre-commit's `ansible-lint ansible/` hook working for anyone who has
# actually installed the pinned dependency locally, rather than failing
# on upstream issues in a role we don't own.
exclude_paths:
  - ansible/roles/geerlingguy.docker/

# Every role referenced by name (e.g. `role: hardening`) needs mocking
# here -- not just in each role's molecule/default/converge.yml, but also
# in the real ansible/playbooks/host-baseline.yml. ansible-lint does not
# resolve role references via ansible.cfg's `roles_path = roles` the way
# `ansible-playbook`/`ansible-galaxy` do; without this, standalone
# ansible-lint reports a false-positive "role not found" even though the
# role resolves correctly both at role-implementation time (roles_path)
# and at molecule-test time (each molecule.yml's ANSIBLE_ROLES_PATH).
mock_roles:
  - docker
  - hardening
  - deploy_user
  - tailscale
  - ops_user
