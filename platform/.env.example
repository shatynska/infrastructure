# Documents every variable platform/docker-compose.yml expects. Real
# values are rendered from GitHub Actions secrets by the deploy workflow
# at deploy time (see openspec's iac-platform-deploy-pipeline capability)
# -- this file exists only as documentation and for local `docker compose
# config` validation with dummy values. Never fill in real values here or
# commit a copy that has them.

# Traefik's ACME (Let's Encrypt) registration email.
ACME_EMAIL=

# Shared PostgreSQL superuser credentials. Per-application databases and
# roles are provisioned separately (see proposal.md's noted follow-up
# work) -- this is the platform stack's own superuser, not any
# application's.
POSTGRES_USER=
POSTGRES_PASSWORD=

# add-platform-monitoring: postgres-exporter's dedicated, restricted-
# privilege role password (role itself is a fixed non-secret name,
# "pgexporter" -- see platform/README.md's manual role-creation step).
POSTGRES_EXPORTER_PASSWORD=

# Alertmanager's receivers: an incoming Slack webhook, and the ping URL
# for the external dead-man's-switch heartbeat service (README.md's other
# manual step).
SLACK_WEBHOOK_URL=
DEADMANSWITCH_URL=

# Grafana's admin credential -- never left at the image default.
GRAFANA_ADMIN_PASSWORD=

# Grafana's tailnet-only bind address, resolved by platform-deploy.yml's
# "Resolve Grafana's tailnet bind address" step -- always a literal IPv4
# address, never a hostname (Docker's ports: host_ip does no DNS
# resolution) and never 0.0.0.0 (Grafana is not meant to be reachable from
# the public interface).
GRAFANA_BIND_ADDRESS=
