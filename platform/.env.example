# Documents every variable platform/docker-compose.yml expects. Real
# values are rendered from GitHub Actions secrets by the deploy workflow
# at deploy time (see openspec's iac-platform-deploy-pipeline capability)
# -- this file exists only as documentation and for local `docker compose
# config` validation with dummy values. Never fill in real values here or
# commit a copy that has them.

# Traefik's ACME (Let's Encrypt) registration email.
ACME_EMAIL=

# Shared PostgreSQL superuser credentials. Per-application databases and
# roles are provisioned separately (see proposal.md's noted follow-up
# work) -- this is the platform stack's own superuser, not any
# application's.
POSTGRES_USER=
POSTGRES_PASSWORD=
