#!/usr/bin/env bash
#
# probe [--path interpolation|env-file] <rendering> <value>
#
# Renders a one-variable `.env` the way the named candidate rendering would,
# runs it through Compose, and prints the base64 of what the container process
# actually received. Prints nothing and exits non-zero if the run did not
# complete -- see "THE THIRD STATE" below, which is the reason that matters.
#
# WHY BASE64, AND WHY FROM INSIDE THE CONTAINER. Base64 so that whitespace,
# line breaks and non-ASCII survive the comparison rather than being eaten by
# the shell reading the result. From inside the container because
# `docker compose config` escapes a literal `$` as `$$` in its own output --
# it reports a value that looks corrupted when it is not, and vice versa, and
# reading it instead of the container is how this problem was twice diagnosed
# backwards.
#
# THE THIRD STATE. A value can come back intact, come back altered, or not
# come back at all because the container never ran. The third must not be
# reported as the second: "resolves to EMPTY" is a real and load-bearing
# result here -- it is the whole of round 2 and the basis on which
# single-quoting was rejected -- so a failed `docker compose run` that printed
# nothing would confirm the design's most important negative result for the
# wrong reason. Hence the status check below rather than `2>/dev/null` and a
# shrug.
set -uo pipefail
cd "$(dirname "$0")"

usage() {
  echo "usage: probe [--path interpolation|env-file] <rendering> <value>" >&2
  echo "renderings: raw double single single-bs single-shell dollar-dollar escaped" >&2
  exit 2
}

path=interpolation
if [ "${1:-}" = "--path" ]; then
  [ $# -ge 2 ] || usage
  path="$2"
  shift 2
fi

[ $# -ge 1 ] || usage
rendering="$1"
value="${2-}"

case "$path" in
  interpolation) compose=interpolation.compose.yaml ;;
  env-file)      compose=env-file.compose.yaml ;;
  *) echo "probe: unknown path '$path'" >&2; usage ;;
esac

# The file under measurement is the only thing that may supply PROBE. Compose
# gives the PROCESS environment precedence over `.env`, so an operator who
# happens to have PROBE exported would measure their own shell instead of the
# rendering, silently, for every value in every round.
unset PROBE

# THE `escaped` RENDERING IS THE WORKFLOW'S OWN FUNCTION, NOT A COPY OF IT.
# Extracted from the committed workflow and sourced, so that what this harness
# measures is what the deploy actually writes. A re-typed copy here would be
# the same mistake in a different file -- it would agree on the day it was
# written and drift silently afterwards, and the harness is this change's only
# behavioural evidence, so evidence measuring a rule the workflow no longer
# applies is worse than none.
workflow_render() {
  local extracted
  extracted="$(mktemp)"
  python3 - "$extracted" <<'PY' || { echo "probe: could not extract the render step from the workflow" >&2; exit 3; }
import pathlib, sys, yaml
root = pathlib.Path(__file__).resolve()
wf = pathlib.Path("../../.github/workflows/platform-deploy.yml").resolve()
doc = yaml.safe_load(wf.read_text())
bodies = [
    step["run"]
    for job in doc["jobs"].values()
    for step in job.get("steps", [])
    if step.get("name") == "Render .env from secrets"
]
if len(bodies) != 1:
    sys.exit(f"expected exactly one 'Render .env from secrets' step, found {len(bodies)}")
body = bodies[0]
start = body.index("render() {")
depth, end = 0, None
for i, ch in enumerate(body[start:], start):
    if ch == "{":
        depth += 1
    elif ch == "}":
        depth -= 1
        if depth == 0:
            end = i + 1
            break
if end is None:
    sys.exit("the render function in that step is not brace-balanced")
pathlib.Path(sys.argv[1]).write_text(body[start:end] + "\n")
PY
  altered=''
  # shellcheck disable=SC1090
  . "$extracted"
  rm -f "$extracted"
}

# A nonce the container echoes back, so that an answer can be proved to have
# come from the run this invocation started rather than from any other
# container. Written into the same file as the value, so both paths carry it.
nonce="n$(date +%s%N)$$"

umask 077
case "$rendering" in
  raw)           printf 'PROBE=%s\n' "$value" >.env ;;
  double)        printf 'PROBE="%s"\n' "$value" >.env ;;
  single)        printf "PROBE='%s'\n" "$value" >.env ;;
  single-bs)     printf "PROBE='%s'\n" "${value//\'/\\\'}" >.env ;;
  single-shell)  printf "PROBE='%s'\n" "${value//\'/\'\\\'\'}" >.env ;;
  dollar-dollar) printf 'PROBE=%s\n' "${value//\$/\$\$}" >.env ;;
  escaped)       workflow_render; render PROBE "$value" >.env ;;
  *) echo "probe: unknown rendering '$rendering'" >&2; usage ;;
esac
printf 'NONCE=%s\n' "$nonce" >>.env

# EACH INVOCATION GETS A PROJECT OF ITS OWN. Without one, a run Compose
# refused leaves a created container behind under the shared project, and a
# later invocation reads THAT container's output -- which was produced from an
# earlier `.env`. Measured: a probe for `${PATH}` returned `ab$c#d`, a value
# from a different round entirely. A per-invocation project name makes every
# run unable to see any other's leavings, and the teardown below removes this
# one's whether or not it completed.
project="probe-$$-${RANDOM}"
err="$(mktemp)"
status=0
out="$(docker compose -p "$project" -f "$compose" run --rm --quiet-pull probe 2>"$err")" || status=$?
docker compose -p "$project" -f "$compose" down --remove-orphans >/dev/null 2>&1 || true

if [ "$status" -ne 0 ]; then
  # A refusal is a THIRD outcome, not a value that came back empty. Compose
  # rejects a file it cannot parse -- "unterminated quoted value" -- and reads
  # nothing, which is loud rather than silent and is not the same result as a
  # parser yielding an empty string.
  reason="$(grep -o 'unterminated quoted value.*' "$err" | head -1)"
  if [ -n "$reason" ]; then
    echo "probe: REFUSED -- $reason" >&2
  else
    echo "probe: the container run did not complete:" >&2
    sed 's/^/  /' "$err" >&2
  fi
  rm -f "$err"
  exit 4
fi
rm -f "$err"

answer="$(printf '%s' "$out" | tr -d '\r\n')"
case "$answer" in
  "$nonce":*) ;;
  *)
    # The answer did not come from this run. Reading another container's
    # output yields a value that is plausible rather than detectably wrong --
    # a batch run produced rows carrying values from a different round
    # entirely before this check existed. Refuse rather than report it.
    echo "probe: the answer did not carry this run's nonce -- refusing to report it as a result" >&2
    exit 5
    ;;
esac
printf '%s' "${answer#*:}"
